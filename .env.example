# ---------------------------------------------------------------------------
# Copier ce fichier en .env et adapter les valeurs.
# .env ne doit JAMAIS etre commite (il est ignore par git).
#
# L'application lit ce fichier au demarrage (spring.config.import), a la racine
# du projet ou du dossier parent. Les variables reellement exportees dans
# l'environnement restent prioritaires.
# ---------------------------------------------------------------------------

# --- Profil et serveur -----------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Base de donnees PostgreSQL --------------------------------------------
# La base doit exister ; Flyway cree les tables, pas la base elle-meme.
DB_URL=jdbc:postgresql://localhost:5432/oravisit
DB_USERNAME=oravisit
DB_PASSWORD=change-me

# --- Jeton d'acces ---------------------------------------------------------
# Secret de signature HS256 encode en Base64 (32 octets minimum une fois
# decode). Obligatoire en profil prod ; le profil dev a une valeur par defaut.
# Generation : openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_EXPIRATION=PT8H
APP_JWT_ISSUER=oravisit

# --- Divers ----------------------------------------------------------------
# Fuseau applicatif : sert aux bornes de journee (« visites du jour ») et aux
# dates des exports Excel.
APP_TIMEZONE=Africa/Lome

# Origines autorisees par CORS, separees par des virgules.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Niveau de log du code applicatif (TRACE, DEBUG, INFO, WARN, ERROR).
APP_LOG_LEVEL=INFO

# --- Amorcage du premier compte ADMIN --------------------------------------
# Il n'existe aucune inscription publique : ce compte est le point d'entree.
# Il est cree par la migration V3, uniquement si le matricule ET le hash sont
# renseignes. Sans ces deux variables, aucun compte n'est cree (le profil dev
# fournit ses propres valeurs de demonstration).
#
# ATTENTION : la variable ci-dessous attend un HASH BCrypt, jamais un mot de
# passe en clair. Un mot de passe en clair serait insere tel quel : le compte
# existerait mais aucune connexion ne serait possible, sans message d'erreur.
#
# Generer le hash :
#   htpasswd -bnBC 10 "" 'MotDePasseFort!' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
# Resultat attendu, de la forme :
#   $2a$10$f6z3MH0BWTMtzvkvju1Bxu1W0gHZQ7ZjbVZLdbkJ7ifJCEkTxGPXW
APP_BOOTSTRAP_ADMIN_MATRICULE=ADM001
APP_BOOTSTRAP_ADMIN_PASSWORD_HASH=
APP_BOOTSTRAP_ADMIN_EMAIL=admin@orabank.tg
APP_BOOTSTRAP_ADMIN_FIRST_NAME=Administrateur
APP_BOOTSTRAP_ADMIN_LAST_NAME=OraVisit
APP_BOOTSTRAP_ADMIN_DIRECTION=DIRECTION_SYSTEMES_INFORMATION
